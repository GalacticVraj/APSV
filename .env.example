# CarbonLoop Environment Variables
# Copy this file to .env and fill in values before running the app.

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carbonloop
DB_USER=carbonloop_user
DB_PASSWORD=your_db_password_here

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Backend API ───────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars
JWT_REFRESH_SECRET=another_long_random_secret_for_refresh_tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Python Optimizer Service ───────────────────────────────────────────────────
OPTIMIZER_URL=http://localhost:8000

# ── AI Layer (at least one must be set; both can coexist) ────────────────────
# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Which provider to use first: "gemini" or "groq". Falls back to the other.
AI_PROVIDER=groq

# ── Email (Nodemailer / SMTP) ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM=CarbonLoop <noreply@carbonloop.in>

# ── Frontend (Vite exposes VITE_ prefixed vars) ───────────────────────────────
VITE_API_BASE_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
